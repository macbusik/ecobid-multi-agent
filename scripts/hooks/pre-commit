#!/bin/bash
# Pre-commit hook to enforce Spec-Driven Development (SDD) workflow
# Checks that code changes have corresponding tasks in tasks.md

set -e

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "🔍 SDD Workflow Check..."

# Get list of changed files (staged for commit)
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check if any code files were changed
CODE_CHANGED=false
for file in $CHANGED_FILES; do
  if [[ $file == *.ts ]] || [[ $file == *.tsx ]] || [[ $file == *.js ]] || [[ $file == *.jsx ]]; then
    # Exclude test files, config files, and type definitions
    if [[ $file != *.test.* ]] && [[ $file != *.spec.* ]] && [[ $file != *.config.* ]] && [[ $file != *.d.ts ]]; then
      CODE_CHANGED=true
      break
    fi
  fi
done

# If no code changed, allow commit
if [ "$CODE_CHANGED" = false ]; then
  echo -e "${GREEN}✅ No code changes detected. Commit allowed.${NC}"
  exit 0
fi

# Check if tasks.md was also changed
TASKS_CHANGED=false
for file in $CHANGED_FILES; do
  if [[ $file == *"tasks.md" ]]; then
    TASKS_CHANGED=true
    break
  fi
done

# If code changed but tasks.md didn't, check for bypass flag
if [ "$CODE_CHANGED" = true ] && [ "$TASKS_CHANGED" = false ]; then
  # Check commit message for bypass flag
  COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
  if [ -f "$COMMIT_MSG_FILE" ]; then
    if grep -q "\[skip-sdd\]" "$COMMIT_MSG_FILE" 2>/dev/null; then
      echo -e "${YELLOW}⚠️  SDD check bypassed with [skip-sdd] flag${NC}"
      exit 0
    fi
  fi
  
  echo -e "${RED}❌ SDD VIOLATION DETECTED${NC}"
  echo ""
  echo -e "${YELLOW}Code files were changed but tasks.md was not updated.${NC}"
  echo ""
  echo "SDD Workflow requires:"
  echo "  1. Create task in .kiro/specs/*/tasks.md"
  echo "  2. Get approval"
  echo "  3. Implement code"
  echo "  4. Update task status"
  echo ""
  echo "Changed code files:"
  for file in $CHANGED_FILES; do
    if [[ $file == *.ts ]] || [[ $file == *.tsx ]] || [[ $file == *.js ]] || [[ $file == *.jsx ]]; then
      if [[ $file != *.test.* ]] && [[ $file != *.spec.* ]] && [[ $file != *.config.* ]] && [[ $file != *.d.ts ]]; then
        echo "  - $file"
      fi
    fi
  done
  echo ""
  echo "To fix:"
  echo "  1. Update tasks.md with task status"
  echo "  2. Stage tasks.md: git add .kiro/specs/*/tasks.md"
  echo "  3. Commit again"
  echo ""
  echo "To bypass (emergency only):"
  echo "  Add [skip-sdd] to commit message"
  echo ""
  exit 1
fi

echo -e "${GREEN}✅ SDD workflow followed. Commit allowed.${NC}"
exit 0
